# ---- AI (menu photos, translation, dish knowledge, booking screenshots) ----
# Any OpenAI-compatible endpoint. Recommended: Alibaba Cloud Model Studio (百炼), Singapore
# region, reachable from mainland China and outside it. Without a key: sample data in
# development, "temporarily unavailable" in production.
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
# Vision model reads menu photos and booking screenshots; text model does translation and city guides.
AI_MODEL_VISION=qwen-vl-max
AI_MODEL_TEXT=qwen-plus
# Optional alternative used only when AI_API_KEY is empty: Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Production shows "temporarily unavailable" when a key is missing. Set to 1 only for a public demo.
ALLOW_SAMPLE_DATA=

# ---- Amap / 高德开放平台 Web服务 Key (https://console.amap.com) ----
# Used for POI search, geocoding, transit/walk/drive routes, weather, hotel POIs.
AMAP_KEY=

# ---- Trip.com / 携程 affiliate (https://www.trip.com/affiliate) ----
TRIP_ALLIANCE_ID=
TRIP_SID=
# trip_sub3 value from the link the affiliate dashboard generates (e.g. D20512235)
TRIP_SUB3=
# Locale/currency site for foreign users: www.trip.com (EN). Use hk.trip.com etc. if needed.
TRIP_HOST=www.trip.com

# ---- Fliggy / 飞猪 via 淘宝联盟 (https://pub.alimama.com) ----
# Taobao Union PID, e.g. mm_123_456_789. Fliggy links are converted to 淘宝客 links
# with the official tbk API in production; here we append the pid to a Fliggy search URL.
FLIGGY_PID=

# ---- eSIM affiliates (optional) ----
# Paste the tracking link each programme gives you; without one the plain site is used.
ESIM_AIRALO_URL=
ESIM_HOLAFLY_URL=
ESIM_SAILY_URL=
ESIM_NOMAD_URL=
ESIM_KLOOK_URL=
# Trip.com eSIMs reuse TRIP_ALLIANCE_ID / TRIP_SID above.

# ---- City guides (sights + dishes for hot cities) ----
# Any long random string. Lets the monthly job (scripts/build-city-guides.mjs) force a refresh;
# without it guides are still generated on first request and cached for 30 days.
CITY_GUIDE_TOKEN=

# ---- Dish knowledge base (optional; SPEC v0.5 P1.7 #29) ----
# Caches what the AI says about each dish so the second lookup needs no model call.
# Server-side only. Create the tables with supabase/migrations/0001_dishes.sql.
# Without these, dishes are cached in memory per server instance.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
